						<input type="number" id="durationInput" placeholder="Time in Seconds....."
							class="moving-placeholder" />

						<div class="progress-bar" id="myBar" style="margin-left: 10px;"></div>
					</div>
					<div class="row">

						<button class="container" id="call-button" onclick="handleCall()">Call</button>
						<button class="container" id="acknowledge-button" onclick="handleAcknowledge()"
							disabled>ACK</button>
						<button class="container" id="end-button" onclick="handleEnd()" disabled>End</button>
					</div>
