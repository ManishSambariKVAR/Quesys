    <style>
        .input-container {
            position: relative;
            display: flex;
        }

        .input-container input[type="text"] {
            flex: 1;
            padding: 5px 20px 5px 20px;
            font-size: 13px;
            border-radius: 5px;
            border: 1px solid #ccc;
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
        }

        .input-container button {
            padding: 5px;
            background-color: #323036;
            color: #fff;
            border: none;
            border-radius: 0 5px 5px 0;
            cursor: pointer;
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            margin: auto;
        }

        .styled-button {
            background-color: #886cc0;
            color: white;
            border: none;
            padding: 0px 5px;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .styled-button:hover {
            background-color: #6c4bae;
        }

        @media only screen and (max-width: 768px) {
            .auth-form2 {
                flex-direction: column;
                align-items: center;
            }

            .input-container {
                width: 100%;
                margin-bottom: 10px;
            }

            .input-container input[type="text"],
            .input-container button {
                width: 100%;
            }

            .input-container button {
                margin-top: 10px;
                position: relative;
            }

            .button {
                margin-top: 10px;
            }
        }

        #checkbox {
            width: 20px !important;
            height: 20px !important;
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2) !important;
        }

        .input-container input {
            padding: 5px 10px;
            font-size: 13px;
            border-radius: 5px;
            border: 1px solid #ccc;
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
        }

        table {
            width: 100%;
            margin: 0 auto;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 8px;
            border: 1px solid #ccc;
            text-align: left;
        }

        .styled-button {
            font-size: 20px;
            border: none;
            border-radius: 5px;
            padding: 10px 15px;
            cursor: pointer;
        }
    </style>

</head>

