	<style>
		* {
			font-family: Arial, sans-serif !important;
		}

		.modal {
			display: none;
			position: fixed;
			z-index: 1000;
			left: 0;
			top: 0;
			width: 100%;
			height: 100%;
			overflow: auto;
			background-color: rgba(0, 0, 0, 0.5);
		}

		.modal-content {
			background-color: #fefefe;
			margin: 15% auto;
			padding: 16px;
			border: 1px solid #888;
			width: 40%;
			border-radius: 8px;
		}


		@keyframes modalFadeIn {
			to {
				transform: translateY(0);
				opacity: 1;
			}
		}

		.close {
			position: absolute;
			top: 8px;
			right: 16px;
			font-size: 30px;
			font-weight: bold;
			color: #aaa;
		}

		.close:hover,
		.close:focus {
			color: black;
			text-decoration: none;
			cursor: pointer;
		}

		.modal-heading {
			font-size: 24px;
			margin-bottom: 20px;
			text-align: center;
		}

		.modal button {
			background-color: #007bff;
			border: none;
			padding: 10px 20px;
			margin: 10px 5px 0 0;
			border-radius: 5px;
			color: white;
			font-size: 16px;
			cursor: pointer;
			transition: background-color 0.3s ease;
		}

		.modal button:hover {
			background-color: #0056b3;
		}

		.recall-btn {
			background-image: linear-gradient(to right, #06beb6, #48b1bf);
			color: #ffffff;
			font-size: 16px;
			padding: 5px 15px;
			border: none;
			cursor: pointer;
			border-radius: 7px;
			box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
			transition: all 0.2s ease-in-out;
			display: inline-block;
			margin: 5px;
			text-decoration: none;
		}

		.recall-btn:hover {
			background-image: linear-gradient(to right, #48b1bf, #06beb6);
			box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
			transform: scale(1.05);
		}

		.recall-btn:focus {
			outline: none;
		}

		.recall-btn:active {
			transform: scale(0.95);
			box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
		}

		.reAssign-btn {
			background-image: linear-gradient(to right, red);
			color: #ffffff;
			font-size: 16px;
			padding: 5px 15px;
			border: none;
			cursor: pointer;
			border-radius: 7px;
			box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
			transition: all 0.2s ease-in-out;
			display: inline-block;
			margin: 5px;
			text-decoration: none;
		}

		.reAssign-btn:hover {
			background-image: linear-gradient(to right, #48b1bf, #06beb6);
			box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
			transform: scale(1.05);
		}

		.reAssign-btn:focus {
			outline: none;
		}

		.reAssign-btn:active {
			transform: scale(0.95);
			box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
		}

		th {
			border: 2px solid black;
		}

		.sub-header {
			display: flex !important;
			flex-wrap: wrap !important;
			justify-content: space-between !important;
			align-items: center !important;
		}

		.dashboard_bar {
			margin: 0 !important;
		}

		.d-flex {
			display: flex !important;
			align-items: center !important;
		}

		.currentTime {
			margin-left: auto !important;
		}

		@media (max-width: 768px) {
			.sub-header {
				flex-direction: column !important;
				align-items: flex-start !important;
			}

			.dashboard_bar {
				margin-bottom: 10px !important;
			}

			.currentTime {
				margin-left: 0 !important;
