        <script>
            document.addEventListener('DOMContentLoaded', function () {
                    var exportExcelBtn = document.getElementById('exportExcel');
                    var exportPDFBtn = document.getElementById('exportPDF');
                    var exportCSVBtn = document.getElementById('exportCSV');
                    var exportJSONBtn = document.getElementById('exportJSON');

                    const today = new Date().toISOString().split('T')[0]; // Get today's date in "YYYY-MM-DD" format
                    const fromDateInput = document.getElementById('fromDate');
                    const toDateInput = document.getElementById('toDate');

                    // Set default values for the date inputs
                    fromDateInput.value = today;
                    toDateInput.value = today;

                if (exportExcelBtn) exportExcelBtn.addEventListener('click', exportToExcel);
                if (exportPDFBtn) exportPDFBtn.addEventListener('click', exportToPDF);
                if (exportCSVBtn) exportCSVBtn.addEventListener('click', exportToCSV);
                if (exportJSONBtn) exportJSONBtn.addEventListener('click', exportToJSON);
                var dataObjects = [];
                <% data.forEach((dta) => { %>
                    dataObjects.push({
                        department: "<%= dta.dep %>",
                        totalTokens: <%= dta.token_total_count %>,
                        skippedTokens: <%= dta.token_skip_count %>,
                        servedTokens: <%= dta.token_total_count - dta.token_skip_count %>,
                        percentageOfServedTokens: 0, // This will be calculated based on aggregation
                        date: "<%= dta.date %>"
                    });
                <% }); %>

                    // Function to update data based on selected date range
                    function updateDataObjects() {
                        // Get the selected date range
                        var fromDate = document.getElementById('fromDate').value;
                        var toDate = document.getElementById('toDate').value;

                        // If no fromDate selected, consider the first available date
                        if (!fromDate && dataObjects.length > 0) {
                            fromDate = dataObjects[0].date;
                            document.getElementById('fromDate').value = fromDate;
                        }

                        // If no toDate selected, calculate dynamically
                        if (!toDate && dataObjects.length > 0) {
                            toDate = dataObjects[dataObjects.length - 1].date;
                            document.getElementById('toDate').value = toDate;
                        }

                        // Filter dataObjects based on the selected date range
                        const filteredDataObjects = dataObjects.filter(obj => {
                            const objDate = new Date(obj.date);
                            return (!fromDate || objDate >= new Date(fromDate)) && (!toDate || objDate <= new Date(toDate));
                        });

                        const departmentMap = {};

                        filteredDataObjects.forEach(obj => {
                            const department = obj.department;
                            if (!departmentMap[department]) {
                                departmentMap[department] = {
                                    department: department,
                                    totalTokens: 0,
                                    skippedTokens: 0,
                                    servedTokens: 0,
                                    percentageOfServedTokens: 0
                                };
                            }
                            // Aggregate values for each department
                            departmentMap[department].totalTokens += obj.totalTokens;
                            departmentMap[department].skippedTokens += obj.skippedTokens;
                            departmentMap[department].servedTokens += obj.servedTokens;
                        });

                        // Calculate percentageOfServedTokens for each department
                        Object.values(departmentMap).forEach(department => {
                            department.percentageOfServedTokens = department.servedTokens / department.totalTokens * 100;
                        });

                        // Now 'departmentMap' contains the consolidated data for each department
                        console.log("MAP");
                        console.log(departmentMap);

                        const departmentHeadersRow = document.getElementById('departmentHeaders');
                        // Clear existing department headers except for the 'Total' column
                        departmentHeadersRow.innerHTML = '<th></th>'; // Assuming the first column is for some category or label

                        // Add department names dynamically to the headers
                        Object.keys(departmentMap).forEach(department => {
                            const headerCell = document.createElement('th');
                            headerCell.textContent = department;
                            headerCell.setAttribute('style', 'text-align: center;');
                            departmentHeadersRow.appendChild(headerCell);
                        });

                        // Append the 'Total' column header at the end
                        const totalHeaderCell = document.createElement('th');
                        totalHeaderCell.textContent = 'Total';
                        totalHeaderCell.setAttribute('style', 'text-align: center;');
                        departmentHeadersRow.appendChild(totalHeaderCell);

                        const tbody = document.querySelector('#dataTable tbody');
                        // Clear existing rows in the table body
                        tbody.innerHTML = '';

                        // Initialize counters for the total of all departments
                        let grandTotalTokens = 0;
                        let grandTotalSkippedTokens = 0;
                        let grandTotalServedTokens = 0;

                        // Data rows templates
                        const totalTokensRow = '<tr><th>Total Tokens</th>';
                        const skippedTokensRow = '<tr><th>Skipped Tokens</th>';
                        const servedTokensRow = '<tr><th>Served Tokens</th>';
                        const percentageOfServedTokensRow = '<tr><th>% Of Served Tokens</th>';

                        // Temporary variables to hold row HTML
                        let totalTokensHTML = totalTokensRow;
                        let skippedTokensHTML = skippedTokensRow;
                        let servedTokensHTML = servedTokensRow;
                        let percentageOfServedTokensHTML = percentageOfServedTokensRow;

                        // Iterate over each department in departmentMap to fill the rows and calculate totals
                        Object.values(departmentMap).forEach(department => {
                            totalTokensHTML += `<td><center>${department.totalTokens}</center></td>`;
                            skippedTokensHTML += `<td><center>${department.skippedTokens}</center></td>`;
                            servedTokensHTML += `<td><center>${department.servedTokens}</center></td>`;
                            percentageOfServedTokensHTML += `<td><center>${department.percentageOfServedTokens.toFixed(2)}%</center></td>`;

                            // Update grand totals
                            grandTotalTokens += department.totalTokens;
                            grandTotalSkippedTokens += department.skippedTokens;
                            grandTotalServedTokens += department.servedTokens;
                        });

                        // Calculate the overall percentage of served tokens
                        let grandPercentageOfServedTokens = (grandTotalServedTokens / grandTotalTokens * 100) || 0;

                        // Append the total columns for each row
                        totalTokensHTML += `<td><strong><center>${grandTotalTokens}</center></strong></td>`;
                        skippedTokensHTML += `<td><strong><center>${grandTotalSkippedTokens}</center></strong></td>`;
                        servedTokensHTML += `<td><strong><center>${grandTotalServedTokens}</center></strong></td>`;
                        percentageOfServedTokensHTML += `<td><strong><center>${grandPercentageOfServedTokens.toFixed(2)}%</center></strong></td>`;

                        // Closing tags for each row
                        totalTokensHTML += '</tr>';
                        skippedTokensHTML += '</tr>';
                        servedTokensHTML += '</tr>';
                        percentageOfServedTokensHTML += '</tr>';

                        // Append the completed row HTML to the table body
                        tbody.innerHTML += totalTokensHTML;
                        tbody.innerHTML += skippedTokensHTML;
                        tbody.innerHTML += servedTokensHTML;
                        tbody.innerHTML += percentageOfServedTokensHTML;

                        // Perform further calculations and updates based on filteredDataObjects...
                    }

                // Call updateDataObjects when the date range changes
                document.getElementById('fromDate').addEventListener('change', updateDataObjects);
                document.getElementById('toDate').addEventListener('change', updateDataObjects);

                // Initial update
                updateDataObjects();
            });



            function exportToExcel() {
                const fromDate = document.getElementById('fromDate').value;
                const toDate = document.getElementById('toDate').value;

                if (!fromDate || !toDate) {
                    alert("Please select both 'From' and 'To' dates.");
                    return;
                }

                console.log(`Exporting data for the date range: ${fromDate} - ${toDate}`);

                const departmentHeadersRow = document.getElementById('departmentHeaders');
                const departmentNames = Array.from(departmentHeadersRow.querySelectorAll('th')).slice(1) // Exclude the 'Total' column
                    .map(th => th.textContent.trim());

                // Fetch all rows from the table body
                var rows = document.querySelectorAll('#dataTable tbody tr');
                if (rows.length === 0) {
                    alert("No data to export.");
                    return;
                }

                // Initialize array for data to be exported, including headers
                var dataToExport = [["From:" + fromDate + " To:" + toDate, ...departmentNames]];

                // Add data rows to the export array
                rows.forEach(row => {
                    let rowData = Array.from(row.cells, cell => cell.textContent.trim());
                    dataToExport.push(rowData);
                });

                // Use XLSX library to create and download the Excel file
                var wb = XLSX.utils.book_new();
                var ws = XLSX.utils.aoa_to_sheet(dataToExport);
                XLSX.utils.book_append_sheet(wb, ws, "Exported Data");

                // Generate a filename based on the date range
                const filename = `Exported_Data_${fromDate}_to_${toDate}.xlsx`;
                XLSX.writeFile(wb, filename);
            }


            // Helper function to convert date format from "yyyy-mm-dd" to "dd-mm-yyyy"
            function formatDateToDDMMYYYY(dateString) {
                var [year, month, day] = dateString.split('-');
                return `${day}-${month}-${year}`;
            }

        </script>

        <script>
            function exportToPDF() {
                const fromDate = document.getElementById('fromDate').value;
                const toDate = document.getElementById('toDate').value;

                if (!fromDate || !toDate) {
                    alert("Please select both 'From' and 'To' dates.");
                    return;
                }

                const departmentHeadersRow = document.getElementById('departmentHeaders');
                const departmentNames = [...Array.from(departmentHeadersRow.querySelectorAll('th')).map(th => th.textContent.trim())];

                const rows = document.querySelectorAll('#dataTable tbody tr');
                if (rows.length === 0) {
                    alert("No data to export.");
                    return;
                }

                const filteredRows = [];

                rows.forEach(row => {
                    let rowData = [row.cells[0].textContent.trim(), ...Array.from(row.cells).slice(1).map(cell => cell.textContent.trim())];
                    filteredRows.push(rowData);
                });

                try {
                    const { jsPDF } = window.jspdf;
                    const doc = new jsPDF();

                    doc.text(`Filtered Data - From: ${fromDate} to ${toDate}`, 10, 10);

                    // Define the table headers separately
                    const head = [departmentNames];

                    // Pass headers and body data separately to autoTable
                    doc.autoTable({
                        head: head,
                        body: filteredRows,
                        theme: 'grid',
                        margin: { top: 20 },
                        didDrawPage: function (data) {
                            // This can be used to set up page numbers, document titles, etc.
                        }
                    });

                    doc.save(`filtered_data_${fromDate}_to_${toDate}.pdf`);
                } catch (error) {
                    console.error('Error exporting PDF:', error);
                    alert('Error exporting PDF. Please check the console for details.');
                }
            }

        </script>

        <script>
            function exportToCSV() {
                const fromDate = document.getElementById('fromDate').value;
                const toDate = document.getElementById('toDate').value;

                if (!fromDate || !toDate) {
                    alert("Please select both 'From' and 'To' dates.");
                    return;
                }

                // Fetching department names dynamically from the table's header
                const departmentHeadersRow = document.getElementById('departmentHeaders');
                // Assuming 'departmentHeadersRow' is correctly targeting your headers, you might need to adjust this selector
                const departmentNames = Array.from(departmentHeadersRow.querySelectorAll('th')).slice(1) // This removes the first header presumed to be not a department name
                    .map(th => th.textContent.trim());

                let csvRows = [];

                // Constructing the header row, incorporating the date range into the first cell, followed directly by department names
                let dateRangeLabel = `"From: ${fromDate} To: ${toDate}"`; // Making sure this is treated as one entry
                let headerRow = [dateRangeLabel, ...departmentNames].join(","); // This ensures no empty column after the date range
                csvRows.push(headerRow);

                // Fetch all data rows
                let rows = document.querySelectorAll('#dataTable tbody tr');

                // Assuming the first cell of each data row should match up with the 'dateRangeLabel' (i.e., left blank or filled appropriately)
                rows.forEach(row => {
                    // Constructing row data, starting with an empty string or a specific value for the date range column if needed
                    let rowData = [...Array.from(row.cells).map(cell => `"${cell.textContent.trim()}"`)].join(",");
                    csvRows.push(rowData);
                });

                if (csvRows.length <= 1) { // Only the header row exists, no data rows found
                    alert("No data available for export.");
                    return;
                }

                // Downloading the CSV
                downloadCSV(csvRows.join("\n"), `Exported_Data_${fromDate}_to_${toDate}.csv`);
            }

            function downloadCSV(csvContent, filename) {
                var blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
                var link = document.createElement("a");
                if (link.download !== undefined) { // Feature detection
                    // Browsers that support HTML5 download attribute
                    var url = URL.createObjectURL(blob);
                    link.setAttribute("href", url);
                    link.setAttribute("download", filename);
                    link.style.visibility = 'hidden';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                }
            }


        </script>


        <script>
            function exportToJSON() {
                const fromDate = document.getElementById('fromDate').value;
                const toDate = document.getElementById('toDate').value;

                if (!fromDate || !toDate) {
                    alert("Please select both 'From' and 'To' dates.");
                    return;
                }

                console.log(`Exporting data for the date range: ${fromDate} - ${toDate}`);

                const departmentHeadersRow = document.getElementById('departmentHeaders');
                const departmentNames = Array.from(departmentHeadersRow.querySelectorAll('th')).slice(1) // Assuming the first column is not a department name
                    .map(th => th.textContent.trim());

                var rows = document.querySelectorAll('#dataTable tbody tr');
                if (rows.length === 0) {
                    alert("No data to export.");
                    return;
                }

                // Initialize array for JSON data to be exported, starting with a custom header object
                var jsonData = [{
                    "Date Range": `From: ${formatDateToDDMMYYYY(fromDate)} To: ${formatDateToDDMMYYYY(toDate)}`,
                    "Departments": departmentNames
                }];

                // Add row data to the JSON array
                rows.forEach(row => {
                    let rowDataArray = Array.from(row.cells, cell => cell.textContent.trim());
                    let rowDataObject = {}; // Initialize an empty object to store row data

                    departmentNames.forEach((name, index) => {
                        // Match department name with cell data, note: index + 1 is used if the first cell is not department name
                        rowDataObject[name] = rowDataArray[index + 1]; // Adjust index as necessary based on your table structure
                    });

                    jsonData.push(rowDataObject);
                });

                // Convert JSON array to string
                var jsonString = JSON.stringify(jsonData, null, 2);

                // Download JSON file
                downloadJSON(jsonString, `Exported_Data_${fromDate}_to_${toDate}.json`);
            }

            function downloadJSON(jsonData, filename) {
                var dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(jsonData);
                var downloadAnchorNode = document.createElement('a');
                downloadAnchorNode.setAttribute("href", dataStr);
                downloadAnchorNode.setAttribute("download", filename);
                document.body.appendChild(downloadAnchorNode); // required for firefox
                downloadAnchorNode.click();
                downloadAnchorNode.remove();
            }

            // Helper function to convert date format from "yyyy-mm-dd" to "dd-mm-yyyy"
            function formatDateToDDMMYYYY(dateString) {
                var [year, month, day] = dateString.split('-');
                return `${day}-${month}-${year}`;
            }

        </script>

