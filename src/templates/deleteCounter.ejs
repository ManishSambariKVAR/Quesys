        <div class="content-body">
            <div class="container-fluid">
                <h3>Counter Delete</h3>
                <table>
                    <thead>
                        <tr>
                            <th>Sr No</th>
                            <th>Counter</th>
                            <th>Status</th>
                            <th>Display Id</th>
                            <th>Buzzer Time</th>
                            <th>Buzzer Active</th>
                            <th>Blink</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% departments.forEach((department, index)=> { %>
                            <tr>
                                <td>
                                    <div class="input-container">
                                        <div style="position: relative;">
                                            <input type="text" id="inputSR_<%= department.id %>" placeholder=""
                                                name="department" style="width: 100%;" value="<%= index + 1 %>"
                                                readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-container">
                                        <div style="position: relative;">
                                            <input type="text" id="inputCounter_<%= department.id %>"
                                                placeholder="Enter Department" name="department" style="width: 100%;"
                                                value="<%= department.counter %>" readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-container">
                                        <div>
                                            <input type="text" id="inputKioskKey_<%= department.id %>"
                                                placeholder="Kiosk Key" name="kioskKey" style="width: 100%;"
                                                value="<%= department.active %>" readonly>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="input-container">
                                        <div>
                                            <input type="text" id="inputKiosk_<%= department.id %>"
                                                placeholder="KisokID" name="kisokId" style="width: 100%;"
                                                value="<%= department.displayid %>" readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-container">
                                        <div>
                                            <input type="text" id="inputKiosk_<%= department.id %>"
                                                placeholder="KisokID" name="kisokId" style="width: 100%;"
                                                value="<%= department.buzzer_time %>" readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-container">
                                        <div>
                                            <input type="text" id="inputKiosk_<%= department.id %>"
                                                placeholder="KisokID" name="kisokId" style="width: 100%;"
                                                value="<%= department.buzzer_active %>" readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-container">
                                        <div>
                                            <input type="text" id="inputKiosk_<%= department.id %>"
                                                placeholder="KisokID" name="kisokId" style="width: 100%;"
                                                value="<%= department.blink %>" readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-container">
                                        <div>
                                            <input type="text" id="inputIP_<%= department.id %>" placeholder="KisokID"
                                                name="IP" style="width: 100%;" value="<%= department.ipaddress %>"
                                                readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="display: flex; align-items: center;">
                                        <button type="button" id="deleteButton_<%= department.id %>"
                                            class="delete-button" data-id="<%= department.id %>">
                                            <span style="font-size: 20px;"><i class="fa fa-trash"></i></span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>

            </div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const deleteButtons = document.querySelectorAll('.delete-button');

                deleteButtons.forEach(button => {
                    button.addEventListener('click', function () {
                        const departmentId = this.getAttribute('data-id');
                        console.log(departmentId);
                        if (confirm('Are you sure you want to delete this department?')) {
                            fetch(`/deleteCounter?counter=${departmentId}`, { method: 'POST' })
                                .then(response => {
                                    if (response.ok) {
                                        window.location.reload();
                                    } else {
                                        alert('There was an error trying to delete the department.');
                                    }
                                })
                                .catch(error => console.error('Error:', error));
                        }
                    });
                });
            });
        </script>



