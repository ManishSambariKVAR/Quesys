    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var exportExcelBtn = document.getElementById('exportExcel');
            var exportPDFBtn = document.getElementById('exportPDF');
            var exportCSVBtn = document.getElementById('exportCSV');
            var exportJSONBtn = document.getElementById('exportJSON');

            if (exportExcelBtn) exportExcelBtn.addEventListener('click', exportToExcel);
            if (exportPDFBtn) exportPDFBtn.addEventListener('click', exportToPDF);
            if (exportCSVBtn) exportCSVBtn.addEventListener('click', exportToCSV);
            if (exportJSONBtn) exportJSONBtn.addEventListener('click', exportToJSON);
        });

        function exportToExcel() {
            console.log('Exporting to Excel...');
            const filteredRows = getFilteredRows();
            const userId = document.getElementById('userId').value.toUpperCase();
            const department = document.getElementById('department').value.toUpperCase();
            const table = document.querySelector('.table-responsive').querySelector('table');

            // Get header cells excluding the "Occurrence" column
            const headerCells = Array.from(table.querySelectorAll('thead th'))
                .map(cell => cell.textContent.trim())
                .filter(text => text !== "Occurrence");

            // Find the index of the "Occurrence" column
            const occurrenceIndex = Array.from(table.querySelectorAll('thead th'))
                .findIndex(cell => cell.textContent.trim() === "Occurrence");

            const dataToExport = [];

            // Add header cells as the first row
            const headerRow = headerCells.map(cell => ({ v: cell, t: 's' }));
            dataToExport.push(headerRow);

            filteredRows.forEach(row => {
                // Get row data excluding the "Occurrence" column
                let rowData = Array.from(row.cells)
                    .filter((_, index) => index !== occurrenceIndex)
                    .map(cell => {
                        let cellValue = cell.textContent.trim();
                        if (!isNaN(cellValue) && cellValue !== '') {
                            return { v: parseFloat(cellValue), t: 'n' }; // Format as number
                        } else if (cellValue.match(/^\d{2}:\d{2}:\d{2}$/)) {
                            // Format as time
                            let timeParts = cellValue.split(':');
                            let excelTime = (parseInt(timeParts[0]) * 3600 + parseInt(timeParts[1]) * 60 + parseInt(timeParts[2])) / 86400;
                            return { v: excelTime, t: 'n', z: 'hh:mm:ss' }; // Format as time with proper Excel format
                        } else {
                            return { v: cellValue, t: 's' }; // Format as text
                        }
                    });

                dataToExport.push(rowData);
            });

            if (dataToExport.length === 1) {
                alert("No rows matched the criteria.");
                return;
            }

            console.log('Filtered Data:', dataToExport);

            // Prepare workbook and worksheet
            var wb = XLSX.utils.book_new();
            var ws = XLSX.utils.aoa_to_sheet([]);

            // Append each row to the worksheet
            dataToExport.forEach((row, rowIndex) => {
                row.forEach((cell, colIndex) => {
                    let cellRef = XLSX.utils.encode_cell({ c: colIndex, r: rowIndex });
                    ws[cellRef] = { v: cell.v, t: cell.t };
                    if (cell.z) {
                        ws[cellRef].z = cell.z; // Set number format if it exists
                    }
                });
            });

            ws['!ref'] = XLSX.utils.encode_range({ s: { c: 0, r: 0 }, e: { c: headerCells.length - 1, r: dataToExport.length - 1 } });
            XLSX.utils.book_append_sheet(wb, ws, "Filtered Data");
            XLSX.writeFile(wb, 'filtered_data.xlsx');
        }

    </script>

    <script>
        document.getElementById('exportPDF').addEventListener('click', exportTableToPDF);

        function formatDateTime(dateTimeString) {
            if (!dateTimeString) return ''; // If dateTimeString is empty or undefined, return an empty string.
            const date = new Date(dateTimeString);
            if (isNaN(date.getTime())) return ''; // If date is invalid, return an empty string.

            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const year = date.getFullYear();
            const hours = String(date.getHours()).padStart(2, '0');
            const minutes = String(date.getMinutes()).padStart(2, '0');
            const seconds = String(date.getSeconds()).padStart(2, '0');
            return `${day}/${month}/${year} ${hours}:${minutes}:${seconds}`;
        }

        function exportTableToPDF() {
            const headers = [["Department", "User ID", "Token No", "From Dep", "To Dep", "Occurrence", "Date", "Generated Time", "Call Time", "Ack Time", "End Time", "Operator Time", "Waiting Time", "Total Time"]];

            const filteredRows = getFilteredRows();

            let body = filteredRows.map(row => {
                return Array.from(row.cells).map((cell, index) => {
                    const text = cell.textContent.trim();
                    if (index === 7 || index === 8 || index === 9) { // Format Generated Time, Call Time, Ack Time, End Time
                        const formattedDateTime = formatDateTime(text);
                        if (!formattedDateTime) {
                            console.error(`Invalid date-time string: "${text}" at row ${row.rowIndex}, column ${index}`);
                        }
                        return formattedDateTime;
                    }
                    return text;
                });
            });

            if (body.length === 0) {
                alert("No data to export based on the selected criteria.");
                return;
            }

            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('landscape');
            doc.autoTable({
                head: headers,
                body: body,
                styles: { fontSize: 10 },
                margin: { top: 10, right: 10, bottom: 10, left: 10 },
            });

            doc.save('filtered_table_data.pdf');
        }

        function parseDate(dateString) {
            const [day, month, year] = dateString.split('-').map(Number);
            return new Date(year, month - 1, day, 0, 0, 0);
        }

        // Debugging statements for initial load
        console.log('Document loaded.');

        document.getElementById('exportPDF').addEventListener('click', exportTableToPDF);
    </script>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.3.1/jspdf.umd.min.js"></script>
