    <style>
        .input-container {
            position: relative;
            display: flex;
        }

        .input-container input[type="text"] {
            text-align: center;
            flex: 1;
            padding: 5px 20px 5px 20px;
            font-size: 13px;
            border-radius: 5px;
            border: 1px solid #ccc;
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
        }

        .input-container button {
            padding: 5px;
            background-color: #323036;
            color: #fff;
            border: none;
            border-radius: 0 5px 5px 0;
            cursor: pointer;
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            margin: auto;
        }

        .delete-button {
            background-color: #f58181;
            color: white;
            border: none;
            padding: 0px 5px;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .delete-button:hover {
            background-color: #ff0000;
        }

        @media only screen and (max-width: 768px) {
            .auth-form2 {
                flex-direction: column;
                align-items: center;
            }

            .input-container {
                width: 100%;
                margin-bottom: 10px;
            }

            .input-container input[type="text"],
            .input-container button {
                width: 100%;
            }

            .input-container button {
                margin-top: 10px;
                position: relative;
            }

            .button {
                margin-top: 10px;
            }
        }

        #checkbox {
            width: 20px !important;
            height: 20px !important;
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2) !important;
        }

        .input-container input {
            padding: 5px 10px;
            font-size: 13px;
            border-radius: 5px;
            border: 1px solid #ccc;
            box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
        }

        table {
            width: 100%;
            margin: 0 auto;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 8px;
            border: 1px solid #ccc;
            text-align: left;
        }

        .delete-button {
            font-size: 20px;
            border: none;
            border-radius: 5px;
            /* padding: 10px 15px; */
            cursor: pointer;
        }
    </style>
</head>

