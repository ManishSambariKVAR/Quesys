		<div class="modal-content">
			<span class="close"></span>
			<h2 class="modal-heading">Time Expired!</h2>
			<p>Time has expired! Please select an option below to extend the time:</p>
			<button id="add30Secs">Add 30 seconds</button>
			<button id="add60Secs">Add 60 seconds</button>
			<button id="end-button" value="1" onclick="handleEnd()">END</button>
		</div>
	</div>


	<script>
		document.getElementById("add30Secs").addEventListener("click", function () {
			addTime(30000);
			document.getElementById("timeoutModal").style.display = "none";
		});

		document.getElementById("add60Secs").addEventListener("click", function () {
			addTime(60000);
			document.getElementById("timeoutModal").style.display = "none";
		});

		function addTime(additionalTime) {
			clearTimeout(window.timeoutHandle);
			resetProgressBar();
			setTimeout(() => {
				startProgressBar(additionalTime);
			}
				, 1000);

			window.timeoutHandle = setTimeout(function () {
				if (!acknowledgmentStatus) {
					showModal();
				}
			}, additionalTime);
		}
	</script>

