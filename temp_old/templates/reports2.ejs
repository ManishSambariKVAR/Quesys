        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const fromDate = <%- JSON.stringify(fromDate) %>;
                const toDate = <%- JSON.stringify(toDate) %>;
        
                console.log("Initial From Date:", fromDate);
                console.log("Initial To Date:", toDate);
        
                document.getElementById('fromDate').value = fromDate;
                document.getElementById('toDate').value = toDate;
        
                document.getElementById("monthSelectorContainer").style.display = "none";
        
                console.log("Calling updateMonthSelector with:", fromDate, toDate);
                updateMonthSelector(fromDate, toDate);
        
                document.getElementById("fromDate").addEventListener("change", function () {
                    console.log("From Date changed to:", this.value);
                    updateMonthSelector(this.value, document.getElementById("toDate").value);
                });
        
                document.getElementById("toDate").addEventListener("change", function () {
                    console.log("To Date changed to:", this.value);
                    updateMonthSelector(document.getElementById("fromDate").value, this.value);
                });
        
                document.getElementById('monthSelector').addEventListener('change', function () {
                    const selectedMonthValue = this.value;
                    const selectedMonthName = this.options[this.selectedIndex].text;
                    console.log("Month selected in dropdown:", selectedMonthValue, selectedMonthName);
        
                    const year = getYearFromDate(fromDate);
                    console.log("Year derived from From Date:", year);
        
                    const lastDate = getLastDateOfMonth(selectedMonthName, year);
                    console.log("Calculated Last Date for selected month:", lastDate);
        
                    console.log("Filtering data with From Date:", fromDate, "and Last Date:", lastDate);
                    filterData2(fromDate, lastDate);
                });
        
                function getYearFromDate(dateString) {
                    console.log("Extracting year from date:", dateString);
                    const date = new Date(dateString);
                    const year = date.getFullYear();
                    console.log("Extracted year:", year);
                    return year;
                }
        
                function getLastDateOfMonth(month, year) {
                    console.log("Calculating last date of month:", month, "for year:", year);
        
                    if (!(month in monthNames)) {
                        console.error("Invalid month name:", month);
                        return "Invalid month name. Please use the full month name.";
                    }
        
                    const monthNumber = monthNames[month];
                    console.log("Month number for", month, ":", monthNumber);
        
                    const lastDate = new Date(year, monthNumber, 1);
                    console.log("Last date calculated:", lastDate);
        
                    return lastDate.toISOString().split('T')[0];
                }                
        
                function updateMonthSelector(fromDate, toDate) {
                    console.log("Updating month selector for From Date:", fromDate, "and To Date:", toDate);                    
        
                    if (fromDate && toDate) {
                        const fromDateObj = new Date(fromDate);
                        const toDateObj = new Date(toDate);
        
                        const fromYear = fromDateObj.getFullYear();
                        const toYear = toDateObj.getFullYear();
                        const fromMonth = fromDateObj.getMonth();
                        const toMonth = toDateObj.getMonth();
        
                        console.log("From Year:", fromYear, "To Year:", toYear);
                        console.log("From Month:", fromMonth + 1, "To Month:", toMonth + 1);
        
                        let availableMonths = [];
        
                        if (fromYear !== toYear || fromMonth !== toMonth) {
                            if (fromYear === toYear) {
                                console.log("From and To dates are in the same year.");
                                for (let month = fromMonth; month <= toMonth; month++) {
                                    availableMonths.push(month + 1);
                                }
                            } else {
                                console.log("From and To dates span multiple years.");
                                for (let month = fromMonth; month <= 11; month++) {
                                    availableMonths.push(month + 1);
                                }
                                for (let month = 0; month <= toMonth; month++) {
                                    availableMonths.push(month + 1);
                                }
                            }
        
                            console.log("Available months for selection:", availableMonths);
        
                            // Create options for the select
                            const monthSelector = document.getElementById('monthSelector');
                            monthSelector.innerHTML = "";
                            const defaultOption = document.createElement('option');
                            defaultOption.value = "";
                            defaultOption.textContent = "Select Month";
                            defaultOption.selected = true;
                            monthSelector.appendChild(defaultOption);

                            availableMonths.forEach(function (month) {
                                const option = document.createElement('option');
                                option.value = (month < 10 ? "0" : "") + month;
                                option.textContent = new Date(0, month - 1).toLocaleString('default', { month: 'long' });
                                monthSelector.appendChild(option);
                            });

                            monthSelector.addEventListener('change', function () {
                                if (monthSelector.value === "") {
                                    console.log('Default option selected');
                                    // Do any reset logic here if necessary
                                } else {
                                    console.log('User selected month:', monthSelector.value);
                                }
                            });
        
                            console.log("Month selector updated with options.");
                            document.getElementById("monthSelectorContainer").style.display = "block";
                        } else {
                            console.log("From and To dates are in the same month. Hiding month selector.");
                            document.getElementById("monthSelectorContainer").style.display = "none";
                        }
                    } else {
                        console.log("Either From Date or To Date is invalid. Hiding month selector.");
                        document.getElementById("monthSelectorContainer").style.display = "none";
                    }
                }
            });
            
            document.addEventListener('DOMContentLoaded', function () {
                const exportExcelBtn = document.getElementById('exportExcel');
                const exportCSVBtn = document.getElementById('exportCSV');
                const fromDateInput = document.getElementById('fromDate');
                const toDateInput = document.getElementById('toDate');

                const fromDate = <%- JSON.stringify(fromDate) %>;
                const toDate = <%- JSON.stringify(toDate) %>;

                console.log("FROM DATE:",fromDate);
                console.log("TO DATE:",toDate);

                if (exportExcelBtn) exportExcelBtn.addEventListener('click', exportToExcel);
                if (exportCSVBtn) exportCSVBtn.addEventListener('click', exportToCSV);

                const result1 = <%- JSON.stringify(result1) %>;
                console.log("Result1 Data:", result1);
                document.getElementById('monthSelector').addEventListener('change', function () {
                            const selectedMonthValue = this.value;
                            const selectedMonthName = this.options[this.selectedIndex].text;
                            console.log("selectedMonthName:",selectedMonthName);
                            console.log("fromDate:",fromDateInput.value);
                            const year = getYearFromDate(toDate);

                            const lastDate = getLastDateOfMonth(selectedMonthName, year);
                            console.log("Last Date:",lastDate);
                            filterData2(fromDate,lastDate);
                        });

                        function getYearFromDate(dateString) {
                            const date = new Date(dateString);
                            return date.getFullYear();
                        }

                        function getLastDateOfMonth(month, year) {
                            const monthNames = {
                                January: 0, February: 1, March: 2, April: 3, May: 4, June: 5, July: 6, August: 7, September: 8, October: 9, November: 10, December: 11
                            };

                            if (!(month in monthNames)) {
                                return "Invalid month name. Please use the full month name.";
                            }

                            const monthIndex = monthNames[month];

                            const lastDate = new Date(year, monthIndex + 1, 0);

                            return lastDate.toISOString().split('T')[0];
                        }
                        
                        const operatorMap = {};

                        function processResult(data) {
                            for (const key in operatorMap) delete operatorMap[key];

                            data.forEach((item) => {
                                const operator = item.user_id;

                                if (!operatorMap[operator]) {
                                    operatorMap[operator] = {
                                        userId: operator,
                                        totalTokens: 0,
                                        skippedTokens: 0,
                                        servedTokens: 0,
                                        totalTime: 0,
                                    };
                                }

                                const isServed = item.ack_status ? 1 : 0;
                                const endTime = new Date(item.end_time).getTime();
                                const ackTime = new Date(item.ack_time).getTime();
                                const timeSpent = isServed ? Math.max(0, endTime - ackTime) : 0;

                                operatorMap[operator].totalTokens++;
                                operatorMap[operator].skippedTokens += isServed ? 0 : 1;
                                operatorMap[operator].servedTokens += isServed ? 1 : 0;
                                operatorMap[operator].totalTime += timeSpent;
                            });

                            Object.values(operatorMap).forEach((operator) => {
                                operator.percentageOfServedTokens = operator.totalTokens > 0
                                    ? ((operator.servedTokens / operator.totalTokens) * 100).toFixed(2)
                                    : 0;

                                const totalTimeInSeconds = Math.floor(operator.totalTime / 1000);
                                operator.totalTimeFormatted = formatTime(totalTimeInSeconds);

                                const averageTimeInSeconds = operator.servedTokens > 0
                                    ? Math.floor(operator.totalTime / operator.servedTokens / 1000)
                                    : 0;
                                operator.averageTimeFormatted = formatTime(averageTimeInSeconds);
                            });

                            console.log("Operator Map: ", operatorMap);
                            renderTable();
                        }

                        function formatTime(seconds) {
                            return `${Math.floor(seconds / 60).toString().padStart(2, '0')}:${(seconds % 60).toString().padStart(2, '0')}`;
                        }

                        function filterData() {
                            const fromDate = fromDateInput.value ? new Date(fromDateInput.value) : null;
                            const toDate = toDateInput.value ? new Date(toDateInput.value) : null;

                            if (toDate) {
                                toDate.setHours(23, 59, 59, 999);
                            }

                            const filteredDataObjects = result1.filter(obj => {
                                const objDate = new Date(obj.call_time);
                                return (!fromDate || objDate >= fromDate) && (!toDate || objDate <= toDate);
                            });

                            console.log("Filtered Data:", filteredDataObjects);
                            processResult(filteredDataObjects);
                        }

                        function filterData2(fromDateD,toDateD) {
                            const fromDate = fromDateInput.value ? new Date(fromDateInput.value) : null;
                            const toDate = toDateInput.value ? new Date(toDateInput.value) : null;

                            if (toDate) {
                                toDate.setHours(23, 59, 59, 999);
                            }

                            const filteredDataObjects = result1.filter(obj => {
                                const objDate = new Date(obj.call_time);
                                return (!fromDateD || objDate >= fromDateD) && (!toDateD || objDate <= toDateD);
                            });

                            console.log("Filtered Data:", filteredDataObjects);
                            processResult(filteredDataObjects);
                        }

                        function calculateTotals(operatorMap) {
                            let totals = {
                                grandTotalTokens: 0,
                                grandSkippedTokens: 0,
                                grandServedTokens: 0,
                                grandTotalTime: 0
                            };

                            Object.values(operatorMap).forEach((operator) => {
                                totals.grandTotalTokens += operator.totalTokens;
                                totals.grandSkippedTokens += operator.skippedTokens;
                                totals.grandServedTokens += operator.servedTokens;
                                totals.grandTotalTime += operator.totalTime;
                            });

                            return totals;
                        }

                        function renderTable() {
                            const tableHeaderRow = document.getElementById('departmentHeaders');
                            const tableBody = document.querySelector('#dataTable tbody');

                            tableHeaderRow.innerHTML = '<th></th>';
                            tableBody.innerHTML = '';

                            // Precompute totals
                            const { grandTotalTokens, grandSkippedTokens, grandServedTokens, grandTotalTime } = calculateTotals(operatorMap);
                            //console.log("ABCD", grandTotalTokens);

                            // Render table headers
                            Object.keys(operatorMap).forEach((username) => {
                                // Operator column
                                const th = document.createElement('th');
                                th.textContent = username;
                                th.style.textAlign = 'center';
                                th.setAttribute('colspan', '2');
                                tableHeaderRow.appendChild(th);
                            });

                            const totalHeader = document.createElement('th');
                            totalHeader.textContent = 'Total';
                            totalHeader.style.textAlign = 'center';
                            tableHeaderRow.appendChild(totalHeader);

                            // Create table rows
                            const totalTokensRow = createRow('Total Tokens');
                            const skippedTokensRow = createRow('Skipped Tokens');
                            const percentageSkippedRow = createRow('Percentage of Skipped Tokens');
                            const servedTokensRow = createRow('Served Tokens');
                            const percentageServedRow = createRow('Percentage of Served Tokens');

                            // Add blank row for separation
                            const blankRow = document.createElement('tr');
                            blankRow.innerHTML = '<td colspan="100%" style="height: 10px !important; background: #ffffff; border:none;"></td>';

                            const blankRow1 = document.createElement('tr');
                            blankRow1.innerHTML = '<td colspan="100%" style="height: 10px !important; background: #ffffff; border:none;"></td>';

                            const totalTimeRow = createRow('Total Time (mm:ss)');
                            const averageTimeRow = createRow('Average Time Per Token (mm:ss)');

                            // Populate data rows
                            Object.values(operatorMap).forEach((operator) => {
                                appendRowData(totalTokensRow, operator.totalTokens);
                                appendRowData(skippedTokensRow, operator.skippedTokens);
                                appendRowData(percentageSkippedRow, `${((operator.skippedTokens / operator.totalTokens) * 100).toFixed(2)}%`);
                                appendRowData(servedTokensRow, operator.servedTokens);
                                appendRowData(percentageServedRow, `${operator.percentageOfServedTokens}%`);
                                appendRowData(totalTimeRow, operator.totalTimeFormatted);
                                appendRowData(averageTimeRow, operator.averageTimeFormatted);
                                appendRowData(totalTokensRow, `${((operator.totalTokens / grandTotalTokens) * 100).toFixed(2)}%`);
                                appendRowData(skippedTokensRow, `${((operator.skippedTokens / grandSkippedTokens) * 100).toFixed(2)}%`);
                                appendRowData(percentageSkippedRow, '-');
                                appendRowData(servedTokensRow, `${((operator.servedTokens / grandServedTokens) * 100).toFixed(2)}%`);
                                appendRowData(percentageServedRow, '-');
                                appendRowData(totalTimeRow, '-');
                                appendRowData(averageTimeRow, '-');
                            });

                            // Append grand totals
                            appendRowData(totalTokensRow, `<strong>${grandTotalTokens}</strong>`);
                            appendRowData(skippedTokensRow, `<strong>${grandSkippedTokens}</strong>`);
                            appendRowData(
                                percentageSkippedRow,
                                `<strong>${((grandSkippedTokens / grandTotalTokens) * 100).toFixed(2)}%</strong>`
                            );
                            appendRowData(servedTokensRow, `<strong>${grandServedTokens}</strong>`);
                            appendRowData(
                                percentageServedRow,
                                `<strong>${((grandServedTokens / grandTotalTokens) * 100).toFixed(2)}%</strong>`
                            );

                            const grandTotalTimeFormatted = formatTime(Math.floor(grandTotalTime / 1000));
                            appendRowData(totalTimeRow, `<strong>${grandTotalTimeFormatted}</strong>`);

                            const grandAverageTimeFormatted = formatTime(
                                grandServedTokens > 0 ? Math.floor(grandTotalTime / grandServedTokens / 1000) : 0
                            );
                            appendRowData(averageTimeRow, `<strong>${grandAverageTimeFormatted}</strong>`);

                            // Append rows to the table body
                            tableBody.append(
                                totalTokensRow,
                                skippedTokensRow,
                                percentageSkippedRow,
                                servedTokensRow,
                                percentageServedRow,
                                blankRow,
                                totalTimeRow,
                                averageTimeRow
                            );
                        }

                        function createRow(title) {
                            const row = document.createElement('tr');
                            row.innerHTML = `<th style="text-align: left; margin-bottom: 10px !important;">${title}</th>`;
                            return row;
                        }

                        function appendRowData(row, data) {
                            const cell = document.createElement('td');
                            cell.style.textAlign = 'center';
                            cell.style.padding = '0 !important';
                            cell.innerHTML = data;
                            row.appendChild(cell);
                        }

                        function exportToExcel() {
                            exportData('xlsx');
                        }

                        function exportToCSV() {
                            exportData('csv');
                        }

                        function exportData(format) {
                            const fromDate = fromDateInput.value || "All";
                            const toDate = toDateInput.value || "All";
                            const table = document.getElementById('dataTable');
                            const rows = Array.from(table.rows);

                            if (rows.length === 0) {
                                alert("No data to export.");
                                return;
                            }

                            const dataToExport = rows.map((row) => {
                                const rowData = [];
                                Array.from(row.cells).forEach((cell) => {
                                    const colSpan = cell.colSpan || 1;
                                    for (let i = 0; i < colSpan; i++) {
                                        rowData.push(cell.textContent.trim());
                                    }
                                });
                                return rowData;
                            });

                            if (format === 'xlsx') {
                                const wb = XLSX.utils.book_new();
                                const ws = XLSX.utils.aoa_to_sheet(dataToExport);
                                XLSX.utils.book_append_sheet(wb, ws, "Summary Reports");
                                XLSX.writeFile(wb, `Exported_Data_${fromDate}_to_${toDate}.xlsx`);
                            } else {
                                const csvRows = dataToExport.map(row => row.map(cell => `"${cell}"`).join(","));
                                downloadCSV(csvRows.join("\n"), `Exported_Data_${fromDate}_to_${toDate}.csv`);
                            }
                        }

                        function downloadCSV(csvContent, filename) {
                            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
                            const link = document.createElement("a");
                            const url = URL.createObjectURL(blob);
                            link.setAttribute("href", url);
                            link.setAttribute("download", filename);
                            document.body.appendChild(link);
                            link.click();
                            document.body.removeChild(link);
                        }

                        filterData();
                        fromDateInput.addEventListener('change', filterData);
                        toDateInput.addEventListener('change', filterData);
                    });
        </script>
        
