    <script>
        function exportToJSON() {
            const filteredRows = getFilteredRows();
            const headerCells = Array.from(document.querySelector('.table-responsive').querySelector('table').querySelectorAll('thead th'))
                .map(cell => cell.textContent.trim())
                .filter(text => text !== "Occurrence");

            if (filteredRows.length === 0) {
                alert("No rows matched the criteria.");
                return;
            }

            let data = filteredRows.map(row => {
                let rowData = {};
                Array.from(row.cells).forEach((cell, index) => {
                    if (headerCells[index] !== "Occurrence") {
                        rowData[headerCells[index]] = cell.textContent.trim();
                    }
                });
                return rowData;
            });

            var jsonData = JSON.stringify(data, null, 2);
            var blob = new Blob([jsonData], { type: "application/json" });
            var link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = "filtered_data.json";
            link.click();
        }

        // Function to parse date string in "dd-mm-yyyy" format and return a Date object
        function parseDate(dateString) {
            const [day, month, year] = dateString.split('-').map(Number);
            return new Date(year, month - 1, day);
        }

        document.getElementById('exportJSON').addEventListener('click', exportToJSON);
    </script>




    <script>
        function exportToCSV() {
            const filteredRows = getFilteredRows();
            const table = document.querySelector('.table-responsive').querySelector('table');
            const headerCells = Array.from(table.querySelectorAll('thead th'))
                .map(cell => cell.textContent.trim());

            // Get indices of columns to include (excluding "Occurrence")
            const includedIndices = headerCells
                .map((text, index) => text !== "Occurrence" ? index : -1)
                .filter(index => index !== -1);

            // Filtered header cells
            const filteredHeaderCells = headerCells.filter((text, index) => includedIndices.includes(index));

            if (filteredRows.length === 0) {
                alert("No rows matched the criteria.");
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8," + filteredHeaderCells.join(",") + "\n";
            filteredRows.forEach(row => {
                let rowData = Array.from(row.cells)
                    .map((cell, index) => includedIndices.includes(index) ? cell.textContent.trim() : null)
                    .filter(cell => cell !== null)
                    .join(",");
                csvContent += rowData + "\n";
            });

            var encodedUri = encodeURI(csvContent);
            var link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "filtered_data.csv");
            document.body.appendChild(link);
            link.click();
        }

        function parseDate(dateString) {
            const [day, month, year] = dateString.split('-').map(Number);
            return new Date(year, month - 1, day);
        }

        document.getElementById('exportCSV').addEventListener('click', exportToCSV);
    </script>

