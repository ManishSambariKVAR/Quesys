		<style>
			.skipped-token {
				color: red;
				background-color: transparent;
				font-weight: bold;

			}
		</style>

		<script>
			var previousAckTime = '';
			var previousTotalTokens = 0;
			var previousReassignTokens = 0;

			function askPermission() {
				Notification.requestPermission().then((permission) => {
					if (permission === "granted") {
						console.log("Notification permission granted.");
					} else {
						console.warn("Notification permission denied.");
					}
				});
			}

			function requestNotificationPermission() {
				if (!("Notification" in window)) {
					console.error("This browser does not support notifications.");
					return;
				}

				if (Notification.permission === "granted") {
					console.log("Notification permission already granted.");
				} else if (Notification.permission !== "denied") {
					Notification.requestPermission().then((permission) => {
						if (permission === "granted") {
							console.log("Notification permission granted.");
						} else {
							console.warn("Notification permission denied.");
						}
					});
				} else {
					askPermission();
					console.warn("Notification permission has been denied previously.");
				}
			}

			document.addEventListener("DOMContentLoaded", () => {
				console.log("Permissions for notification");
				requestNotificationPermission();

			});

			function showNotification(title, options) {
				if (Notification.permission === "granted") {
					new Notification(title, options);
				} else {
					console.warn("Cannot show notification: permission not granted.");
				}
			}

			function updateTokenData() {
				var tokenDataRequest = new XMLHttpRequest();
				tokenDataRequest.onreadystatechange = function () {
					if (this.readyState == 4 && this.status == 200) {
						var response = JSON.parse(this.responseText);
						var data = response.data[0];
						var prefix = response.prefix;
						var token_logs = response.token_log;
						var user = response.user;
						var temp = document.getElementById("generatedToken").innerText;
						var reassign = 0;
						if (data.reassign_token === null || isNaN(data.reassign_token)) {
							reassign = 0;
						} else {
							reassign = data.reassign_token;
						}
						document.getElementById("TotalTokens").innerText = prefix + data.token_total_count;
						document.getElementById("BalanceTokens").innerText = data.token_total_count - data.token_current_count;
						document.getElementById("TotalSkipTokens").innerText = data.token_skip_count;
						document.getElementById("TotalReAssignTokens").innerText = data.reassign_token || 0;
						document.getElementById("prefix_M").innerText = prefix;
						if (current_bypass == false) {
							document.getElementById("current").innerText = data.token_current_count;
							document.getElementById("generatedToken").innerText = prefix + data.token_current_count;
						}

						const totalTokens = parseInt(data.token_total_count);
						const currentTokens = parseInt(data.token_current_count);

						if ((totalTokens === 0) || (totalTokens === currentTokens) && call_en_recall === false) {
							document.getElementById("call-button").disabled = true;
						} else if (!current_bypass && totalTokens > currentTokens) {
							document.getElementById("call-button").disabled = false;
						} else if ((totalTokens === 0) || (totalTokens === currentTokens) && call_en_recall === true) {
							document.getElementById("call-button").disabled = false;
						}


						let alphabetPart = temp.match(/[A-Za-z]+/)[0];
						let numberPart = temp.match(/\d+/)[0];

						console.log("Alphabet Part: ", alphabetPart);
						console.log("Number Part: ", numberPart);

						if(alphabetPart !== prefix && reassign >= 0 && call_en_recall === true){
							document.getElementById("call-button").disabled = false;
						}
						if (totalTokens > previousTotalTokens) {
							new Notification('Token Count Updated', {
								body: `New token count: ${totalTokens}`,
							});
							console.log("Token Count : Incremented");
						}

						if (reassign > previousReassignTokens) {
							new Notification('Reassign Token', {
								body: `Resign Token: Found`,
							});
							console.log("Reassign Activated");
						}
						previousReassignTokens = reassign;
						previousTotalTokens = totalTokens;

						populateTokenLogsTable(response.token_log, prefix);
					}
				};

				tokenDataRequest.open(
					"GET",
					"/updateData?userId=<%= user.id %>&userName=<%= user.name %>&userDepartment=<%= user.department %>&counter=<%= user.counter %>&kioskId=<%= user.kioskId %>",
					true
				);
				tokenDataRequest.send();
			}

			updateTokenData();
			setInterval(function () {
				updateTokenData();
			}, 500);

			const rowsPerPage = 10;
			let currentPage = 1;
			let currentTokenLogs = [];

			function populateTokenLogsTable(token_logs, prefix) {
				currentTokenLogs = token_logs.sort((a, b) => b.token_id - a.token_id); // Sort in descending order
				renderTable();
			}

			function renderTable() {
				const tableBody = document.getElementById("customers");
				tableBody.innerHTML = ""; // Clear existing rows

				const start = (currentPage - 1) * rowsPerPage;
				const end = Math.min(start + rowsPerPage, currentTokenLogs.length);

				const userDep = document.getElementById('userDep');
				const og = document.getElementById("prefix_M").innerText;

				let item_legth = 0;

				currentTokenLogs.forEach(function (log) {
					console.log("LOG_ID : " + log.user_id);
					if (log.user_id !== '0') {
						//console.log("REassign Dep ",log.reassign_dep);
							var row = document.createElement("tr");
							item_legth = item_legth + 1;
							var tokenIDCell = document.createElement("td");
							if (log.prefix !== og || (log.reassign_dep === log.dep && log.reassign_active === true )) {
								tokenIDCell.classList.add("skipped-token");
								tokenIDCell.innerHTML = "<center>" + log.prefix + log.token_id + "</center>";
								row.appendChild(tokenIDCell);
							} else {
								tokenIDCell.innerHTML = "<center>" + log.prefix + log.token_id + "</center>";
								row.appendChild(tokenIDCell);
							}
							tokenIDCell.innerHTML = "<center>" + log.prefix + log.token_id + "</center>";
							row.appendChild(tokenIDCell);

							if (log.ack_status === false && log.time_interval === null) {
								var skippedTokenCell = document.createElement("td");
								skippedTokenCell.classList.add("skipped-token");
								skippedTokenCell.innerHTML = "<center>SKIPPED</center>";
								row.appendChild(skippedTokenCell);

								var callTimeCell = document.createElement("td");
								callTimeCell.innerHTML = "<center>" + previousAckTime + "</center>";
								row.appendChild(callTimeCell);
							} else {
								const ackTimeDate = new Date(log.ack_time);
								const formattedAckTime = ackTimeDate.toLocaleString('en-GB', {
									day: '2-digit',
									month: '2-digit',
									year: 'numeric',
									hour: '2-digit',
									minute: '2-digit',
									second: '2-digit',
									fractionalSecondDigits: 3
								});

								var skippedTokenCell = document.createElement("td");
								skippedTokenCell.innerHTML = "<center>" + (formattedAckTime ? formattedAckTime : "N/A") + "</center>";
								row.appendChild(skippedTokenCell);

								var timeIntervalStr = '';
								if (log.time_interval) {
									timeIntervalStr = formatTimeInterval(log.time_interval);
								} else {
									timeIntervalStr = "N/A";
								}

								var callTimeCell = document.createElement("td");
								callTimeCell.innerHTML = "<center>" + timeIntervalStr + "</center>";
								row.appendChild(callTimeCell);
							}

							var recallButtonCell = document.createElement("td");
							var recallButton = document.createElement("button");
							recallButton.className = "recall-btn";
							recallButton.innerHTML = "ReCall";
							recallButton.addEventListener("click", function () {
								handelRecall(log.token_id, log.prefix);
							});


							var recallButtonCell2 = document.createElement("td");
							var recallButton2 = document.createElement("button");
							recallButton2.className = "recall-btn";
							recallButton2.innerHTML = "ReAssign";

							if (log.reassign_active === null) {
								recallButtonCell.appendChild(recallButton);
								row.appendChild(recallButtonCell);
								recallButtonCell2.appendChild(recallButton2);
								row.appendChild(recallButtonCell2);
							} else {
								if (log.reassign_active === true && log.reassign_dep !== log.dep && userDep.value !== log.dep) {

									recallButtonCell.appendChild(recallButton);
									row.appendChild(recallButtonCell);
									recallButton2.disabled = true; // Disable the button
									// document.getElementById("reassign_bool").innerText = true;
									recallButtonCell2.appendChild(recallButton2);
									row.appendChild(recallButtonCell2);
								} else if (log.reassign_active === false && log.reassign_dep !== log.dep && userDep.value !== log.dep) {
									recallButtonCell.appendChild(recallButton);
									row.appendChild(recallButtonCell);

									// document.getElementById("reassign_bool").innerText = true;
									recallButtonCell2.appendChild(recallButton2);
									row.appendChild(recallButtonCell2);
								} else if (log.reassign_active === true && log.reassign_dep === log.dep && userDep.value === log.dep) {
									recallButtonCell.appendChild(recallButton);
									row.appendChild(recallButtonCell);
									// document.getElementById("reassign_bool").innerText = false;
									recallButtonCell2.appendChild(recallButton2);
									row.appendChild(recallButtonCell2);
								}
								else {
									recallButton.disabled = true; // Disable the button
									recallButtonCell.appendChild(recallButton);
									row.appendChild(recallButtonCell);

									recallButton2.disabled = true; // Disable the button
									recallButtonCell2.appendChild(recallButton2);
									row.appendChild(recallButtonCell2);
								}

							}
							recallButtonCell2.addEventListener("click", function () {
								showModal2(log, log.prefix);
							});
							//console.log("Start:",start);
							//console.log("END:",end);
							if (item_legth >= start && item_legth <= end || (start === 0 && item_legth > 0 )) {
								tableBody.appendChild(row);
							}

					}
				});

				//console.log("DATA lEng: " + item_legth);

				document.getElementById('page-info').textContent = `Page ${currentPage} of ${Math.ceil(item_legth / rowsPerPage)}`;
				document.getElementById('prev-btn').disabled = currentPage === 1;
				document.getElementById('next-btn').disabled = end >= currentTokenLogs.length;
			}

			function prevPage() {
				if (currentPage > 1) {
					currentPage--;
					renderTable();
				}
			}

			function nextPage() {
				if ((currentPage * rowsPerPage) < currentTokenLogs.length) {
					currentPage++;
					renderTable();
				}
			}

			function showModal2(log, prefix) {
				var modal = document.getElementById("myModalR");
				modal.style.display = "block";
				let tokenIdElement = document.getElementById("tokenId");
				let tokenId2Element = document.getElementById("tokenId2Value");
				const TokNo = document.getElementById('tokenId2');
				TokNo.value = log.token_id;

				const log_id = document.getElementById('logId');
				log_id.value = log.log_id;

				// Set the value of the element
				tokenIdElement.innerText = prefix + log.token_id;
				tokenId2Element.innerText = prefix + log.token_id;
				console.log(JSON.stringify(log));
				// Get the confirm and cancel buttons
				var confirmButton = document.getElementById("confirmReAssign");
				var cancelButton = document.getElementById("cancelReAssign");

				// When the user clicks on the confirm button, handle the recall
				confirmButton.onclick = function () {
					handelRecall(log.token_id, log.prefix);
					modal.style.display = "none";
				};

				// When the user clicks on the cancel button, close the modal
				cancelButton.onclick = function () {
					modal.style.display = "none";
				};

				// When the user clicks anywhere outside of the modal, close it
				window.onclick = function (event) {
					if (event.target == modal) {
						modal.style.display = "none";
					}
				};

				// When the user clicks on <span> (x), close the modal
				var span = document.getElementsByClassName("close")[0];
				span.onclick = function () {
					modal.style.display = "none";
				};
			}
			function formatTimeInterval(timeInterval) {
				var formattedTime = '';
				if (timeInterval.hours) {
					formattedTime += timeInterval.hours + " : ";
				} else {
					formattedTime += "00 : ";
				}
				if (timeInterval.minutes) {
					formattedTime += timeInterval.minutes + " : ";
				} else {
					formattedTime += "00 : ";
				}
				if (timeInterval.seconds) {
					formattedTime += timeInterval.seconds + " : ";
				} else {
					formattedTime += "00 : ";
				}
				if (timeInterval.milliseconds) {
					formattedTime += timeInterval.milliseconds;
				} else {
					formattedTime += "00";
				}
				return formattedTime;
			}
		</script>

