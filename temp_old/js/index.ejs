									<h1 class="text-black mb-2 font-w600"><span id="TotalTokens">000</span></h1>
								</div>
							</div>
						</div>
						<div class="col-xl-3 col-sm-6 m-t35">
							<div class="card card-coin">
								<div class="card-body text-center">
									<h4 class="text-black mb-2 font-w600">Current Token: </h4>
									<h1 class="text-black mb-2 font-w600"><span id="generatedToken">000</span></h1>
								</div>
							</div>
						</div>
						<div class="col-xl-3 col-sm-6 m-t35">
							<div class="card card-coin">
								<div class="card-body text-center">
									<h4 class="text-black mb-2 font-w600">Balance Token: </h4>
									<h1 class="text-black mb-2 font-w600">000</h1>
								</div>
							</div>
						</div>
						<div class="col-xl-3 col-sm-6 m-t35">
							<div class="card card-coin">
								<div class="card-body text-center">
									<h4 class="text-black mb-2 font-w600">Total Skip Token: </h4>
									<h1 class="text-black mb-2 font-w600">000</h1>
								</div>
							</div>
						</div>
					</div>
				</div>
			</form>

			<div class="row">
				<div class="col-lg-12">
					<div class="card">
