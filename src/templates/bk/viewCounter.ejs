        <div class="content-body">
            <div class="container-fluid">
                <h4 class="text-center mb-4">DEPARTMENTS</h4>
                <table>
                    <thead>
                        <tr>
                            <th>Sr No.</th>
                            <th>Department</th>
                            <th>Kiosk Key</th>
                            <th>Display</th>
                            <th>Display Prefix</th>
                            <th>Buzzer On/Off</th>
                            <th>Buzzer Time(millis)</th>
                            <th>Flash</th>
                            <th>Kiosk Id</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% departments.forEach((department, index)=> { %>
                            <tr>
                                <td>
                                    <div class="input-container">
                                        <div style="position: relative;">
                                            <input type="text" id="inputSR_<%= department.id %>" placeholder="" name=""
                                                style="width: 100%;" value="<%= index + 1 %>" readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-container">
                                        <div style="position: relative;">
                                            <input type="text" id="inputDepartment_<%= department.id %>"
                                                placeholder="Enter Department" name="department" style="width: 100%;"
                                                value="<%= department.department %>" readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-container">
                                        <div>
                                            <input type="text" id="inputKioskKey_<%= department.id %>"
                                                placeholder="Kiosk Key" name="kioskKey" style="width: 100%;"
                                                value="<%= department.kiosk_key %>" readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-container">
                                        <div>
                                            <input type="text" id="inputDisplay_<%= department.id %>"
                                                placeholder="Display" name="display" style="width: 100%;"
                                                value="<%= department.display %>" readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-container">
                                        <div style="position: relative;">
                                            <input type="text" id="inputDepPrefix_<%= department.id %>" placeholder=""
                                                name="departmentPrefix" style="width: 100%;"
                                                value="<%= department.display_prefix %>" readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-container">
                                        <div>
                                            <input type="text" id="inputBuzzer_<%= department.id %>"
                                                placeholder="Buzzer On/Off" name="buzzer" style="width: 100%;"
                                                value="<%= department.buzzer_repeat %>" readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-container">
                                        <div>
                                            <input type="text" id="inputBuzzerTime_<%= department.id %>"
                                                placeholder="Buzzer Time (in millis)" name="buzzerTime"
                                                style="width: 100%;" value="<%= department.buzzer_time %>" readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-container">
                                        <div>
                                            <input type="text" id="inputFlash_<%= department.id %>" placeholder="Flash"
                                                name="flash" style="width: 100%;" value="<%= department.blink %>"
                                                readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="input-container">
                                        <div>
                                            <input type="text" id="inputKiosk_<%= department.id %>" placeholder="Kiosk Id"
                                                name="kiosk" style="width: 100%;" value="<%= department.kiosk_id %>"
                                                readonly>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="display: flex; align-items: center;">
                                        <button type="button" class="edit-button"
                                            data-department-id="<%= department.id %>">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <% }); %>
                    </tbody>


                </table>
            </div>
            <div id="editModal" class="modal">
                <div class="modal-content">
                    <span class="close-button" style="margin-left: 95%;">&times;</span>
                    <h2>Edit Department</h2>
                    <form id="editForm">
                        <input type="hidden" id="editId" name="departmentId">
                        <div class="input-container" style="width: 150px;">
                            <input type="text" id="editDepartment" name="department" placeholder="Department">
                        </div>
                        <div class="input-container" style="width: 150px;">
                            <input type="text" id="editKioskKey" name="kioskKey" placeholder="Kiosk Key">
                        </div>
                        <div class="input-container" style="width: 150px;">
                            <input type="text" id="editDisplay" name="display" placeholder="Display">
                        </div>
                        <div class="input-container" style="width: 150px;">
                            <input type="text" id="editDepartmentPrefix" name="depPrefix"
                                placeholder="Display Prefix">
                        </div>
                        <div class="input-container" style="width: 150px;">
                            <input type="text" id="editBuzzer" name="buzzer" placeholder="Buzzer">
                        </div>
                        <div class="input-container" style="width: 150px;">
                            <input type="text" id="editBuzzerTime" name="buzzerTime" placeholder="Buzzer Time">
                        </div>
                        <div class="input-container" style="width: 150px;">
                            <input type="text" id="editFlash" name="flash" placeholder="Flash">
                        </div>
                        <div class="input-container" style="width: 150px;">
                            <!-- <input type="text" id="modalKioskId" name="kioskID" placeholder="Kiosk ID"> -->
                            <select id="modalKioskId" id="editKiosk" name="kiosk" >
                                <% kiosks.forEach(kiosk=> { %>
                                    <option value="<%= kiosk.kiosk_id %>">
                                        <%= kiosk.kiosk_id %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <button class="submit-button" type="submit"><i class="fas fa-save"></i></button>
                    </form>
                </div>
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var modal = document.getElementById("editModal");
                var span = document.getElementsByClassName("close-button")[0];

                document.querySelectorAll('.edit-button').forEach(button => {
                    button.onclick = function () {
                        var id = this.getAttribute('data-department-id');
                        var row = this.closest('tr');
                       
                        document.getElementById('editId').value = id;
                        document.getElementById('editDepartment').value = row.querySelector('input[name="department"]').value;
                        document.getElementById('editKioskKey').value = row.querySelector('input[name="kioskKey"]').value;
                        document.getElementById('editDisplay').value = row.querySelector('input[name="display"]').value;
                        document.getElementById('editDepartmentPrefix').value = row.querySelector('input[name="departmentPrefix"]').value;
                        document.getElementById('editBuzzer').value = row.querySelector('input[name="buzzer"]').value;
                        document.getElementById('editBuzzerTime').value = row.querySelector('input[name="buzzerTime"]').value;
                        document.getElementById('editFlash').value = row.querySelector('input[name="flash"]').value;
                        //document.getElementById('editKiosk').value = row.querySelector('input[name="kiosk"]').value;

                        modal.style.display = "block";
                    }
                });

                span.onclick = function () {
                    modal.style.display = "none";
                }

                window.onclick = function (event) {
                    if (event.target == modal) {
                        modal.style.display = "none";
                    }
                }

                document.getElementById("saveChanges").addEventListener("click", function () {
                    var id = document.getElementById('editId').value;
                    console.log("Save changes for ID:", id);
                    modal.style.display = "none";
                });
            });

            document.getElementById("editForm").onsubmit = async function (e) {
                e.preventDefault();

                const formData = new FormData(this);

                try {
                    const response = await fetch('/DepartmentReg', {
                        method: 'POST',
                        body: formData,
                    });

                    if (response.ok) {
                        console.log("Updated successfully");
                        window.location.reload();
                    } else {
                        console.error("Failed to update");
                    }
                } catch (error) {
                    console.error('Error:', error);
                }
            };

        </script>



