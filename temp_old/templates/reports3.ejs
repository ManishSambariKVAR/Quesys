        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const exportExcelBtn = document.getElementById('exportExcel');
                const exportCSVBtn = document.getElementById('exportCSV');
                const fromDateInput = document.getElementById('fromDate');
                const toDateInput = document.getElementById('toDate');

                // Event listeners for export buttons
                if (exportExcelBtn) exportExcelBtn.addEventListener('click', exportToExcel);
                if (exportCSVBtn) exportCSVBtn.addEventListener('click', exportToCSV);

                const result1 = <%- JSON.stringify(result1) %>; // Replace with actual data
                const grievances = <%- JSON.stringify(grievances) %>; // Replace with grievance data
                console.log("Result1 Data:", result1);
                console.log("Grievances:", grievances);

                const operatorMap = {};

                // Process and aggregate data by operator (user_id)
                function processResult(data) {
                    for (const key in operatorMap) delete operatorMap[key];

                    data.forEach((item) => {
                        const operator = item.user_id;

                        if (!operatorMap[operator]) {
                            operatorMap[operator] = {
                                userId: operator,
                                totalTokens: 0,
                                skippedTokens: 0,
                                servedTokens: 0,
                                totalTime: 0, // Total Time in milliseconds
                                grievances: {} // Track grievances dynamically
                            };
                        }

                        const isServed = item.ack_status ? 1 : 0;
                        const endTime = new Date(item.end_time).getTime();
                        const ackTime = new Date(item.ack_time).getTime();
                        const timeSpent = isServed ? Math.max(0, endTime - ackTime) : 0;

                        // Aggregate counts
                        operatorMap[operator].totalTokens++;
                        operatorMap[operator].skippedTokens += isServed ? 0 : 1;
                        operatorMap[operator].servedTokens += isServed ? 1 : 0;
                        operatorMap[operator].totalTime += timeSpent;

                        // Update grievance counts dynamically
                        const grievance = item.info?.grievance || "Unknown";
                        operatorMap[operator].grievances[grievance] =
                            (operatorMap[operator].grievances[grievance] || 0) + 1;
                    });

                    renderTable();
                }

                // Filter result1 based on dates
                function filterData() {
                    const fromDate = fromDateInput.value ? new Date(fromDateInput.value) : null;
                    const toDate = toDateInput.value ? new Date(toDateInput.value) : null;

                    if (toDate) {
                        // Set time to the end of the day
                        toDate.setHours(23, 59, 59, 999);
                    }

                    const filteredDataObjects = result1.filter(obj => {
                        const objDate = new Date(obj.call_time);
                        return (!fromDate || objDate >= fromDate) && (!toDate || objDate <= toDate);
                    });

                    console.log("Filtered Data:", filteredDataObjects);
                    processResult(filteredDataObjects);
                }

                // Render grievances table
                function renderTable() {
                    const tableHeaderRow = document.getElementById('departmentHeaders');
                    const tableBody = document.querySelector('#dataTable tbody');

                    // Clear existing content
                    tableHeaderRow.innerHTML = '<th style="text-align: center;">Operator</th>';
                    tableBody.innerHTML = '';

                    // Add grievance headers dynamically
                    grievances.forEach((grievance) => {
                        const th = document.createElement('th');
                        th.textContent = grievance;
                        th.setAttribute('style', 'text-align: center;');
                        tableHeaderRow.appendChild(th);
                    });

                    // Add total column
                    const thTotal = document.createElement('th');
                    thTotal.textContent = "Total";
                    thTotal.setAttribute('style', 'text-align: center;');
                    tableHeaderRow.appendChild(thTotal);

                    Object.values(operatorMap).forEach((operator) => {
                        const row = document.createElement('tr');

                        // Operator column
                        const operatorCell = document.createElement('td');
                        operatorCell.textContent = operator.userId;
                        operatorCell.setAttribute('style', 'text-align: center;');
                        row.appendChild(operatorCell);

                        // Grievance columns
                        grievances.forEach((grievance) => {
                            const cell = document.createElement('td');
                            cell.textContent = operator.grievances[grievance] || 0;
                            cell.setAttribute('style', 'text-align: center;');
                            row.appendChild(cell);
                        });

                        // Total tokens column
                        const totalCell = document.createElement('td');
                        totalCell.textContent = operator.totalTokens;
                        totalCell.setAttribute('style', 'text-align: center;');
                        row.appendChild(totalCell);

                        tableBody.appendChild(row);
                    });
                }

                // Export functions
                function exportToExcel() {
                    exportData('xlsx');
                }

                function exportToCSV() {
                    exportData('csv');
                }

                function exportData(format) {
                    const departmentNames = Array.from(document.querySelectorAll('#departmentHeaders th')).map(th => th.textContent.trim());
                    const rows = document.querySelectorAll('#dataTable tbody tr');

                    if (rows.length === 0) {
                        alert("No data to export.");
                        return;
                    }

                    const dataToExport = [[...departmentNames]];
                    rows.forEach(row => {
                        const rowData = Array.from(row.cells).map(cell => cell.textContent.trim());
                        dataToExport.push(rowData);
                    });

                    if (format === 'xlsx') {
                        const wb = XLSX.utils.book_new();
                        const ws = XLSX.utils.aoa_to_sheet(dataToExport);
                        XLSX.utils.book_append_sheet(wb, ws, "Grievances Report");
                        XLSX.writeFile(wb, `Grievances_Report.xlsx`);
                    } else {
                        const csvRows = dataToExport.map(row => row.map(cell => `"${cell}"`).join(","));
                        downloadCSV(csvRows.join("\n"), `Grievances_Report.csv`);
                    }
                }

                function downloadCSV(csvContent, filename) {
                    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
                    const link = document.createElement("a");
                    const url = URL.createObjectURL(blob);
                    link.setAttribute("href", url);
                    link.setAttribute("download", filename);
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                }

                // Initialize filter and render
                filterData();
                fromDateInput.addEventListener('change', filterData);
                toDateInput.addEventListener('change', filterData);
            });

        </script>
        
